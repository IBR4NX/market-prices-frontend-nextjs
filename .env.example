# Main API URL used by the frontend application.
REACT_APP_API_URL="https://your-api-domain.example.com/api"

# Local development API URL; uncomment to use it instead of the default setting.
# VITE_API_URL="http://localhost:5000/api"

# API URL for the Vite app.
VITE_API_URL="https://your-api-domain.example.com/api"

# Site name displayed in the UI and SEO metadata.
NEXT_PUBLIC_SITE_NAME="Your Site Name"

# Main site URLs for each section.
NEXT_PUBLIC_MAIN_URL="https://your-domain.example.com"
NEXT_PUBLIC_ABOUT_URL="https://about.your-domain.example.com"
NEXT_PUBLIC_PRICES_URL="https://prices.your-domain.example.com"
NEXT_PUBLIC_BLOG_URL="https://blog.your-domain.example.com"

# Verification token for PubSubHubbub to validate subscription requests.
NEXT_PUBLIC_PUBSUBHUBBUB_VERIFY_TOKEN="replace-with-your-verify-token"

# Blob store ID in Vercel.
img_STORE_ID="your-store-id"

# Read/write token for Blob Storage. Do not place a real secret in this file.
BLOB_READ_WRITE_TOKEN="your-blob-read-write-token"

# Public access URL for product files in Blob Storage.
NEXT_PUBLIC_BLOB_PRODUCT_URL="your-project-id.public.blob.vercel-storage.com"

# Folder used to store product images.
NEXT_PUBLIC_BLOB_PRODUCT_FOLDER="product-images"

# Allowed file type for product images.
NEXT_PUBLIC_BLOB_PRODUCT_TYPE="webp"
